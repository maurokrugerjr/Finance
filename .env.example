# PostgreSQL (usado pela API via Prisma)
DATABASE_URL="postgresql://finance:finance@localhost:5432/finance"

# API
PORT=3333
# O valor padrão só é aceito com NODE_ENV=development/test (pnpm dev já
# define development). Fora disso, use um segredo aleatório de 32+ caracteres,
# ex.: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-secret"
CORS_ORIGIN="http://localhost:3000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3333"
