    "@fastify/sensible": "^6.0.2",
    "@finance/types": "workspace:*",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.0",
    "prisma": "^5.19.1",
